# =============================================================================
# Data Lakehouse — Variáveis de Ambiente
# Copie para .env e ajuste os valores: cp .env.example .env
# =============================================================================

# --- PostgreSQL (Fonte OLTP) -------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=datalakehouse
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=password

# --- Kafka (KRaft) -----------------------------------------------------------
KAFKA_BROKER=localhost:9094
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- MinIO (S3-compatible) ---------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=lakehouse
MINIO_ROOT_PASSWORD=changeme_minio
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# --- Iceberg REST Catalog ----------------------------------------------------
CATALOG_URI=http://localhost:8181
CATALOG_WAREHOUSE=s3://warehouse/

# --- Airflow (gere valores aleatórios antes de subir o profile) --------------
# AIRFLOW__CORE__FERNET_KEY: .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# AIRFLOW_JWT_SECRET / AIRFLOW_DB_PASSWORD: openssl rand -hex 32
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_DB_PASSWORD=
AIRFLOW_UID=50000
# Webhook HTTP opcional para alertas de falha das tasks.
AIRFLOW_ALERT_WEBHOOK_URL=

# --- DuckDB / MotherDuck -----------------------------------------------------
MOTHERDUCK_TOKEN=

# --- FastAPI -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=changeme_api_secret

# --- Debezium / Kafka Connect ------------------------------------------------
CONNECT_BOOTSTRAP_SERVERS=kafka:9092
CONNECT_GROUP_ID=lakehouse-connect
CONNECT_REST_PORT=8083
CONNECT_REST_URL=http://localhost:8083
